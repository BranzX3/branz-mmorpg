{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "spell.schema.json",
  "title" : "SPELL definition",
  "type" : "object",
  "additionalProperties" : true,
  "properties" : {
    "definition_id" : {
      "type" : "string",
      "description" : "Stable lowercase dotted definition identity."
    },
    "schema_version" : {
      "type" : "integer",
      "description" : "Public content schema version.",
      "x-unit" : "schema version",
      "minimum" : 1.0
    },
    "cast_type" : {
      "type" : "string",
      "description" : "Spell cast mode.",
      "enum" : [ "CHANNEL", "CHARGE", "INSTANT", "RITUAL", "SUSTAIN", "WINDUP" ]
    },
    "target_type" : {
      "type" : "string",
      "description" : "Spell targeting mode.",
      "enum" : [ "CONE", "CROSSHAIR_ENTITY", "CROSSHAIR_POINT", "GROUND_AREA", "PROJECTILE", "SELF", "TETHERED_ALLY" ]
    },
    "delivery" : {
      "type" : "string",
      "description" : "Spell delivery mode.",
      "enum" : [ "BEAM", "DIRECT", "IMBUE", "PROJECTILE", "SUMMON", "ZONE" ]
    },
    "art" : {
      "type" : "string",
      "description" : "Owning magic art identity."
    },
    "requirements" : {
      "type" : "object",
      "properties" : {
        "catalyst_tags" : {
          "type" : "array",
          "description" : "Required catalyst compatibility tags.",
          "minItems" : 1
        },
        "attunement" : {
          "type" : "integer",
          "description" : "Required active attunement capacity.",
          "x-unit" : "capacity",
          "minimum" : 0.0
        },
        "attunement_tags" : {
          "type" : "array",
          "description" : "Spell resonance and Attunement tags.",
          "minItems" : 1
        },
        "conflicts_with_tags" : {
          "type" : "array",
          "description" : "Tags that make this spell incompatible.",
          "minItems" : 1
        }
      },
      "required" : [ "catalyst_tags", "attunement" ]
    },
    "cost" : {
      "type" : "object",
      "properties" : {
        "mana" : {
          "type" : "integer",
          "description" : "Mana reserved at start and spent at release.",
          "x-unit" : "mana",
          "minimum" : 0.0
        }
      },
      "required" : [ "mana" ]
    },
    "phases" : {
      "type" : "object",
      "properties" : {
        "windup_ticks" : {
          "type" : "integer",
          "description" : "Pre-charge windup duration.",
          "x-unit" : "ticks",
          "minimum" : 0.0,
          "maximum" : 200.0
        },
        "minimum_charge_ticks" : {
          "type" : "integer",
          "description" : "Earliest release after charge begins.",
          "x-unit" : "ticks",
          "minimum" : 0.0,
          "maximum" : 200.0
        },
        "maximum_charge_ticks" : {
          "type" : "integer",
          "description" : "Forced release boundary after charge begins.",
          "x-unit" : "ticks",
          "minimum" : 0.0,
          "maximum" : 200.0
        },
        "recovery_ticks" : {
          "type" : "integer",
          "description" : "Post-commit recovery duration.",
          "x-unit" : "ticks",
          "minimum" : 0.0,
          "maximum" : 200.0
        }
      },
      "required" : [ "windup_ticks", "minimum_charge_ticks", "maximum_charge_ticks", "recovery_ticks" ]
    },
    "interruption" : {
      "type" : "object",
      "properties" : {
        "movement" : {
          "type" : "boolean",
          "description" : "Whether movement interrupts the cast."
        },
        "damage" : {
          "type" : "boolean",
          "description" : "Whether health damage interrupts the cast."
        },
        "flinch" : {
          "type" : "boolean",
          "description" : "Whether Flinch interrupts the cast."
        },
        "stagger" : {
          "type" : "boolean",
          "description" : "Whether Stagger interrupts the cast."
        },
        "silence" : {
          "type" : "boolean",
          "description" : "Whether Silence interrupts the cast."
        },
        "weapon_swap" : {
          "type" : "boolean",
          "description" : "Whether weapon swap interrupts the cast."
        }
      },
      "required" : [ "movement", "damage", "flinch", "stagger", "silence", "weapon_swap" ]
    },
    "projectile" : {
      "type" : "object",
      "properties" : {
        "speed" : {
          "type" : "number",
          "description" : "Spell projectile launch speed.",
          "x-unit" : "blocks_per_tick",
          "minimum" : 1.0E-6,
          "maximum" : 8.0
        },
        "gravity_per_tick" : {
          "type" : "number",
          "description" : "Spell projectile gravity.",
          "x-unit" : "blocks_per_tick_squared",
          "minimum" : 0.0,
          "maximum" : 1.0
        },
        "drag_per_tick" : {
          "type" : "number",
          "description" : "Spell projectile drag.",
          "x-unit" : "ratio_per_tick",
          "minimum" : 1.0E-6,
          "maximum" : 1.0
        },
        "collision_radius" : {
          "type" : "number",
          "description" : "Spell projectile collision radius.",
          "x-unit" : "blocks",
          "minimum" : 1.0E-6,
          "maximum" : 2.0
        },
        "lifetime_ticks" : {
          "type" : "integer",
          "description" : "Spell projectile lifetime.",
          "x-unit" : "ticks",
          "minimum" : 1.0,
          "maximum" : 400.0
        },
        "pierce_count" : {
          "type" : "integer",
          "description" : "Spell projectile pierce count.",
          "x-unit" : "targets",
          "minimum" : 0.0,
          "maximum" : 7.0
        },
        "hit_group" : {
          "type" : "string",
          "description" : "Spell projectile once-per-target hit group."
        }
      }
    },
    "direct" : {
      "type" : "object",
      "properties" : {
        "range" : {
          "type" : "number",
          "description" : "Maximum direct-delivery target range.",
          "x-unit" : "blocks",
          "minimum" : 1.0E-6,
          "maximum" : 32.0
        },
        "maximum_targets" : {
          "type" : "integer",
          "description" : "Maximum direct targets per commit.",
          "x-unit" : "targets",
          "minimum" : 1.0,
          "maximum" : 1.0
        }
      }
    },
    "channel" : {
      "type" : "object",
      "properties" : {
        "pulse_interval_ticks" : {
          "type" : "integer",
          "description" : "Channel interval between committed pulses.",
          "x-unit" : "ticks",
          "minimum" : 1.0,
          "maximum" : 100.0
        },
        "maximum_pulses" : {
          "type" : "integer",
          "description" : "Maximum pulses before a channel ends.",
          "x-unit" : "pulses",
          "minimum" : 1.0,
          "maximum" : 100.0
        },
        "mana_per_pulse" : {
          "type" : "integer",
          "description" : "Mana paid by each emitted channel pulse.",
          "x-unit" : "mana",
          "minimum" : 0.0
        },
        "range" : {
          "type" : "number",
          "description" : "Maximum server-owned channel target range.",
          "x-unit" : "blocks",
          "minimum" : 1.0E-6,
          "maximum" : 32.0
        },
        "maximum_targets_per_pulse" : {
          "type" : "integer",
          "description" : "Maximum targets hit by one channel pulse.",
          "x-unit" : "targets",
          "minimum" : 1.0,
          "maximum" : 1.0
        }
      }
    },
    "zone" : {
      "type" : "object",
      "properties" : {
        "placement_range" : {
          "type" : "number",
          "description" : "Maximum crosshair placement range.",
          "x-unit" : "blocks",
          "minimum" : 1.0E-6,
          "maximum" : 32.0
        },
        "radius" : {
          "type" : "number",
          "description" : "Zone target radius.",
          "x-unit" : "blocks",
          "minimum" : 1.0E-6,
          "maximum" : 12.0
        },
        "duration_ticks" : {
          "type" : "integer",
          "description" : "Bounded committed zone lifetime.",
          "x-unit" : "ticks",
          "minimum" : 1.0,
          "maximum" : 400.0
        },
        "pulse_interval_ticks" : {
          "type" : "integer",
          "description" : "Zone interval between target pulses.",
          "x-unit" : "ticks",
          "minimum" : 1.0,
          "maximum" : 400.0
        },
        "maximum_targets_per_pulse" : {
          "type" : "integer",
          "description" : "Maximum zone targets per pulse.",
          "x-unit" : "targets",
          "minimum" : 1.0,
          "maximum" : 16.0
        }
      }
    },
    "imbuement" : {
      "type" : "object",
      "properties" : {
        "duration_ticks" : {
          "type" : "integer",
          "description" : "Encounter-scoped weapon Imbuement lifetime.",
          "x-unit" : "ticks",
          "minimum" : 1.0,
          "maximum" : 1200.0
        },
        "maximum_charges" : {
          "type" : "integer",
          "description" : "Maximum physical hits empowered by the Imbuement.",
          "x-unit" : "hits",
          "minimum" : 1.0,
          "maximum" : 32.0
        },
        "power_coefficient" : {
          "type" : "number",
          "description" : "Weapon-power coefficient for each empowered hit.",
          "x-unit" : "coefficient",
          "minimum" : 1.0E-6,
          "maximum" : 2.0
        }
      }
    },
    "output" : {
      "type" : "object",
      "properties" : {
        "arcane_school" : {
          "type" : "string",
          "description" : "Arcane damage channel.",
          "enum" : [ "FIRE", "FROST", "PURE_ARCANE", "STORM", "VOID" ]
        },
        "power_coefficient" : {
          "type" : "number",
          "description" : "Catalyst-power coefficient.",
          "x-unit" : "coefficient",
          "minimum" : 1.0E-6
        },
        "posture" : {
          "type" : "integer",
          "description" : "Posture output.",
          "x-unit" : "posture",
          "minimum" : 0.0
        },
        "guard_pressure" : {
          "type" : "integer",
          "description" : "Guard-pressure output.",
          "x-unit" : "guard_pressure",
          "minimum" : 0.0
        }
      },
      "required" : [ "arcane_school", "power_coefficient", "posture", "guard_pressure" ]
    },
    "presentation" : {
      "type" : "object",
      "properties" : {
        "archetype" : {
          "type" : "string",
          "description" : "Client presentation archetype."
        }
      },
      "required" : [ "archetype" ]
    },
    "profiles" : {
      "type" : "object",
      "properties" : {
        "pve_multiplier" : {
          "type" : "number",
          "description" : "PvE output profile.",
          "x-unit" : "multiplier",
          "minimum" : 1.0E-6
        },
        "pvp_multiplier" : {
          "type" : "number",
          "description" : "PvP output profile.",
          "x-unit" : "multiplier",
          "minimum" : 1.0E-6
        }
      },
      "required" : [ "pve_multiplier", "pvp_multiplier" ]
    }
  },
  "required" : [ "definition_id", "schema_version", "cast_type", "target_type", "delivery", "art", "requirements", "cost", "phases", "interruption", "output", "presentation", "profiles" ]
}