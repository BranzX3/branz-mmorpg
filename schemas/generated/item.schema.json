{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "item.schema.json",
  "title" : "ITEM definition",
  "type" : "object",
  "additionalProperties" : true,
  "properties" : {
    "definition_id" : {
      "type" : "string",
      "description" : "Stable lowercase dotted definition identity."
    },
    "schema_version" : {
      "type" : "integer",
      "description" : "Public content schema version.",
      "x-unit" : "schema version",
      "minimum" : 1.0
    },
    "asset_id" : {
      "type" : "string",
      "description" : "Stable presentation asset ID."
    },
    "item_class" : {
      "type" : "string",
      "description" : "Unique/durable or stackable-lot item class."
    },
    "weapon_profile" : {
      "type" : "object",
      "properties" : {
        "family" : {
          "type" : "string",
          "description" : "Weapon-family runtime identity."
        },
        "power" : {
          "type" : "number",
          "description" : "Base deterministic weapon power.",
          "x-unit" : "power",
          "minimum" : 1.0E-6
        },
        "bow" : {
          "type" : "object",
          "properties" : {
            "minimum_draw_ticks" : {
              "type" : "integer",
              "description" : "Earliest valid Bow release.",
              "x-unit" : "ticks",
              "minimum" : 1.0,
              "maximum" : 99.0
            },
            "full_draw_ticks" : {
              "type" : "integer",
              "description" : "Tick at which Bow charge reaches full draw.",
              "x-unit" : "ticks",
              "minimum" : 2.0,
              "maximum" : 100.0
            },
            "free_full_draw_hold_ticks" : {
              "type" : "integer",
              "description" : "Full-draw hold before strain begins.",
              "x-unit" : "ticks",
              "minimum" : 0.0,
              "maximum" : 200.0
            },
            "strain_stamina_per_second" : {
              "type" : "number",
              "description" : "Strained Bow hold drain.",
              "x-unit" : "stamina_per_second",
              "minimum" : 1.0E-6,
              "maximum" : 20.0
            },
            "minimum_velocity_multiplier" : {
              "type" : "number",
              "description" : "Quick-shot projectile velocity floor.",
              "x-unit" : "ratio",
              "minimum" : 1.0E-6,
              "maximum" : 1.0
            },
            "minimum_posture_multiplier" : {
              "type" : "number",
              "description" : "Quick-shot posture-output floor.",
              "x-unit" : "ratio",
              "minimum" : 1.0E-6,
              "maximum" : 1.0
            },
            "maximum_penetration_percentage" : {
              "type" : "number",
              "description" : "Full-draw armor penetration.",
              "x-unit" : "ratio",
              "minimum" : 0.0,
              "maximum" : 0.4
            }
          }
        },
        "crossbow" : {
          "type" : "object",
          "properties" : {
            "bolt_placement_ticks" : {
              "type" : "integer",
              "description" : "Ticks before a selected bolt binds durably to the Crossbow.",
              "x-unit" : "ticks",
              "minimum" : 1.0
            },
            "locking_ticks" : {
              "type" : "integer",
              "description" : "Ticks from the BOLT_PLACED checkpoint to LOADED.",
              "x-unit" : "ticks",
              "minimum" : 1.0
            }
          }
        }
      }
    },
    "ammo_profile" : {
      "type" : "object",
      "properties" : {
        "family" : {
          "type" : "string",
          "description" : "Ammo family: ARROW or BOLT."
        }
      }
    },
    "quiver_profile" : {
      "type" : "object",
      "properties" : {
        "capacity" : {
          "type" : "integer",
          "description" : "Maximum Quiver storage capacity.",
          "x-unit" : "ammo_units",
          "minimum" : 1.0,
          "maximum" : 4096.0
        },
        "supported_ammo_families" : {
          "type" : "array",
          "description" : "Compatible ARROW/BOLT families.",
          "minItems" : 1,
          "maxItems" : 2
        },
        "prepared_ammo_category_count" : {
          "type" : "integer",
          "description" : "Maximum prepared ammo categories.",
          "x-unit" : "categories",
          "minimum" : 1.0,
          "maximum" : 4.0
        },
        "ammo_switch_handling_ticks" : {
          "type" : "integer",
          "description" : "Engaged ammo-switch handling lock.",
          "x-unit" : "ticks",
          "minimum" : 0.0,
          "maximum" : 40.0
        }
      }
    },
    "catalyst_profile" : {
      "type" : "object",
      "properties" : {
        "tags" : {
          "type" : "array",
          "description" : "Catalyst compatibility tags.",
          "minItems" : 1
        },
        "channel_stability" : {
          "type" : "number",
          "description" : "Bounded catalyst channel stability.",
          "x-unit" : "ratio",
          "minimum" : 0.0,
          "maximum" : 1.0
        },
        "durability_cost_per_commit" : {
          "type" : "integer",
          "description" : "Durability consumed at spell commit.",
          "x-unit" : "durability",
          "minimum" : 1.0
        }
      }
    }
  },
  "required" : [ "definition_id", "schema_version", "asset_id", "item_class" ]
}