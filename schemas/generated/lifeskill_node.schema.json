{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "lifeskill_node.schema.json",
  "title" : "LIFESKILL_NODE definition",
  "type" : "object",
  "additionalProperties" : true,
  "properties" : {
    "definition_id" : {
      "type" : "string",
      "description" : "Stable lowercase dotted definition identity."
    },
    "schema_version" : {
      "type" : "integer",
      "description" : "Public content schema version.",
      "x-unit" : "schema version",
      "minimum" : 1.0
    },
    "node_type" : {
      "type" : "string",
      "description" : "Resource node lifecycle type.",
      "enum" : [ "COMMON", "CORRUPTED", "EVENT", "RARE", "REGIONAL", "RICH" ]
    },
    "action_ticks" : {
      "type" : "integer",
      "description" : "Gathering action duration.",
      "x-unit" : "ticks",
      "minimum" : 30.0,
      "maximum" : 120.0
    },
    "commit_tick" : {
      "type" : "integer",
      "description" : "Gathering commit tick.",
      "x-unit" : "ticks",
      "minimum" : 0.0,
      "maximum" : 120.0
    },
    "recovery_seconds" : {
      "type" : "integer",
      "description" : "Wall-clock recovery duration.",
      "x-unit" : "seconds",
      "minimum" : 0.0
    },
    "base_yields" : {
      "type" : "array",
      "description" : "Base item yields.",
      "minItems" : 1
    }
  },
  "required" : [ "definition_id", "schema_version", "node_type", "action_ticks", "commit_tick", "recovery_seconds", "base_yields" ]
}